# QueryDistill-RL environment template.
#
# Copy to `.env` and adjust. The application NEVER edits your system
# environment; it only reads these values for its own subprocesses.
#
# The values below are the WSL2 paths requested for this machine.
# When the code runs on native Windows it translates /mnt/d/... to D:\...
# automatically. Native Windows forms are shown commented out.

PROJECT_ROOT=/mnt/d/LLMProjects/QueryDistill-RL
# PROJECT_ROOT=D:\LLMProjects\QueryDistill-RL

# ---------- Cache roots: everything must live on D: ----------
HF_HOME=/mnt/d/LLMCache/huggingface
# HF_HOME=D:\LLMCache\huggingface
HF_DATASETS_CACHE=/mnt/d/LLMCache/huggingface/datasets
# HF_DATASETS_CACHE=D:\LLMCache\huggingface\datasets
TORCH_HOME=/mnt/d/LLMCache/torch
# TORCH_HOME=D:\LLMCache\torch
XDG_CACHE_HOME=/mnt/d/LLMCache/xdg
# XDG_CACHE_HOME=D:\LLMCache\xdg
UV_CACHE_DIR=/mnt/d/LLMCache/uv
# UV_CACHE_DIR=D:\LLMCache\uv
PIP_CACHE_DIR=/mnt/d/LLMCache/pip
# PIP_CACHE_DIR=D:\LLMCache\pip
TRITON_CACHE_DIR=/mnt/d/LLMCache/triton
# TRITON_CACHE_DIR=D:\LLMCache\triton
TORCH_EXTENSIONS_DIR=/mnt/d/LLMCache/torch_extensions
# TORCH_EXTENSIONS_DIR=D:\LLMCache\torch_extensions

# ---------- Project data / artifacts ----------
DATA_DIR=/mnt/d/LLMProjects/QueryDistill-RL/data
# DATA_DIR=D:\LLMProjects\QueryDistill-RL\data
MODEL_DIR=/mnt/d/LLMProjects/QueryDistill-RL/models
# MODEL_DIR=D:\LLMProjects\QueryDistill-RL\models
CHECKPOINT_DIR=/mnt/d/LLMProjects/QueryDistill-RL/checkpoints
# CHECKPOINT_DIR=D:\LLMProjects\QueryDistill-RL\checkpoints
ARTIFACT_DIR=/mnt/d/LLMProjects/QueryDistill-RL/artifacts
# ARTIFACT_DIR=D:\LLMProjects\QueryDistill-RL\artifacts
RUN_DIR=/mnt/d/LLMProjects/QueryDistill-RL/runs
# RUN_DIR=D:\LLMProjects\QueryDistill-RL\runs

# ---------- Models (first round: student only, teacher banned) ----------
STUDENT_MODEL_ID=Qwen/Qwen3-0.6B-Base
TEACHER_MODEL_ID=Qwen/Qwen3-4B
# Optional mirror for machines that cannot reach huggingface.co directly.
# Uncomment only if the default endpoint is unreachable.
# HF_ENDPOINT=https://hf-mirror.com

# ---------- SQL executor limits ----------
QD_MAX_EXECUTION_MS=3000
QD_MAX_ROWS=1000
